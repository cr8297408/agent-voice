#!/usr/bin/env python3
"""Speak an agent reply through the local Speaches TTS (Kokoro on GPU).

Usage:
  agent-speak < text            # speak plain text from stdin
  agent-speak --claude-hook     # stdin is a Claude Code Stop hook JSON
  agent-speak --stop            # stop current playback and drop queued replies
Replies are read in full (code removed) and queue behind each other; only --stop cuts them.
Mute with `touch ~/.cache/agent-speak.off` (rm to unmute) or AGENT_SPEAK=0.
When the agent runs inside an SSH session, audio plays on the SSH client
(the Mac) via `ssh $AGENT_SPEAK_SSH afplay` instead of local speakers.
"""
import fcntl, json, os, re, signal, subprocess, sys, tempfile, time, urllib.request
from concurrent.futures import ThreadPoolExecutor

URL = os.environ.get("AGENT_SPEAK_URL", "http://127.0.0.1:8000/v1/audio/speech")
MODEL = os.environ.get("AGENT_SPEAK_MODEL", "speaches-ai/Kokoro-82M-v1.0-ONNX")
VOICE = os.environ.get("AGENT_SPEAK_VOICE", "ef_dora")
STATE = os.path.expanduser("~/.cache/agent-speak")
PIDFILE, OFF, LOCK, STOPPED = STATE + ".pid", STATE + ".off", STATE + ".lock", STATE + ".stopped"
# shortcut: any SSH session plays on this one host; make it per-client if you SSH in from more machines.
REMOTE = os.environ.get("AGENT_SPEAK_SSH", "mac") if os.environ.get("SSH_CONNECTION") else ""
REMOTE_WAV = "/tmp/agent-speak.wav"
# Reuse one SSH connection across chunks so each part starts without a new handshake.
SSH = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "-o", "ControlMaster=auto",
       "-o", f"ControlPath={STATE}-ssh-%C", "-o", "ControlPersist=120", REMOTE]
CHUNK_CHARS = 250


def clean(text: str) -> str:
    text = re.sub(r"```.*?(```|$)", " ", text, flags=re.S)  # fenced code
    text = re.sub(r"`([^`]*)`", r"\1", text)
    text = re.sub(r"!?\[([^\]]*)\]\([^)]*\)", r"\1", text)  # links/images -> label
    text = re.sub(r"^\s*\|.*\|\s*$", " ", text, flags=re.M)  # tables
    text = re.sub(r"https?://\S+", " ", text)
    text = re.sub(r"[*_#>|~]+", " ", text)
    return re.sub(r"\s+", " ", text).strip()


def claude_last_message(hook: dict) -> str:
    if hook.get("last_assistant_message"):
        return hook["last_assistant_message"]
    last = ""  # fallback: newest assistant text block in the transcript
    with open(hook.get("transcript_path", ""), encoding="utf-8") as f:
        for line in f:
            try:
                e = json.loads(line)
            except ValueError:
                continue
            msg = e.get("message") or {}
            if e.get("type") == "assistant" and isinstance(msg.get("content"), list):
                texts = [b.get("text", "") for b in msg["content"] if b.get("type") == "text"]
                if any(t.strip() for t in texts):
                    last = "\n".join(texts)
    return last


def chunks(text: str, limit: int = CHUNK_CHARS) -> list:
    """Split at sentence ends into pieces Kokoro reads in full (it silently drops past ~330 chars)."""
    out, cur = [], ""
    for piece in re.split(r"(?<=[.!?;:])\s+", text):
        while len(piece) > limit:  # one huge sentence: cut at the last space before the limit
            cut = piece.rfind(" ", 0, limit)
            cut = cut if cut > 0 else limit
            if cur:
                out.append(cur)
                cur = ""
            out.append(piece[:cut])
            piece = piece[cut:].lstrip()
        if cur and len(cur) + 1 + len(piece) > limit:
            out.append(cur)
            cur = piece
        else:
            cur = f"{cur} {piece}".strip()
    return out + [cur] if cur else out


def synth(text: str) -> bytes:
    body = json.dumps({"model": MODEL, "voice": VOICE, "input": text, "response_format": "wav"}).encode()
    req = urllib.request.Request(URL, body, {"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=120) as r:
        return r.read()


def play(audio: bytes) -> None:
    with tempfile.NamedTemporaryFile(suffix=".wav") as wav:
        wav.write(audio)
        wav.flush()
        quiet = dict(stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if REMOTE:
            with open(wav.name, "rb") as f:
                subprocess.run(SSH + [f"cat > {REMOTE_WAV} && exec afplay {REMOTE_WAV}"], stdin=f, **quiet)
        else:
            subprocess.run(["pw-play", wav.name], stdin=subprocess.DEVNULL, **quiet)


def stop() -> None:
    open(STOPPED, "w").close()
    os.utime(STOPPED)  # reopening an empty file doesn't bump mtime; queued replies compare against it
    try:
        os.killpg(int(open(PIDFILE).read()), signal.SIGTERM)
    except (OSError, ValueError):
        return  # nothing was playing
    if REMOTE:  # killing the local ssh client does not stop afplay on the Mac
        subprocess.run(SSH + [f"pkill -f 'afplay {REMOTE_WAV}'"], stdin=subprocess.DEVNULL,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)


def stopped_since(t: float) -> bool:
    try:
        return os.path.getmtime(STOPPED) >= t
    except OSError:
        return False


def main() -> None:
    if "--stop" in sys.argv:
        return stop()
    if os.environ.get("AGENT_SPEAK") == "0" or os.path.exists(OFF):
        return
    raw = sys.stdin.read()
    text = clean(claude_last_message(json.loads(raw)) if "--claude-hook" in sys.argv else raw)
    if not text:
        return
    # Detach so the agent never waits on synthesis/playback.
    if os.fork():
        return
    os.setsid()
    queued_at = time.time()
    parts = chunks(text)
    lock = open(LOCK, "w")
    fcntl.flock(lock, fcntl.LOCK_EX)  # wait for the reply already playing to finish
    if stopped_since(queued_at):
        return
    open(PIDFILE, "w").write(str(os.getpid()))  # --stop kills this whole process group
    with ThreadPoolExecutor(max_workers=1) as pool:
        nxt = pool.submit(synth, parts[0])
        for i in range(len(parts)):
            audio = nxt.result()
            if i + 1 < len(parts):
                nxt = pool.submit(synth, parts[i + 1])  # synthesize ahead while this part plays
            play(audio)


if __name__ == "__main__":
    try:
        main()
    except Exception as e:  # never break the agent because TTS failed
        print(f"agent-speak: {e}", file=sys.stderr)
    sys.exit(0)
